---
import '../styles/global.css'
import ExploreFooter from '../components/ExploreFooter.astro'
import Navlinks from '../components/Navlinks.astro'
import Search from '../components/Search.astro'
import {
	getSiteNavigation,
	hasSearchControl,
	pageLinks,
	searchHref,
} from '../lib/siteNavigation'

interface Props {
	title?: string
	description?: string
	ogImage?: string
	ogType?: 'website' | 'article'
	noIndex?: boolean
}

const {
	title = 'Tredyffrin Easttown Historical Society',
	description,
	ogImage,
	ogType = 'website',
	noIndex = false,
} = Astro.props

const nav = await getSiteNavigation()
const headerLinks = pageLinks(nav.primaryLinks)
const showSearch = hasSearchControl(nav.primaryLinks)
const searchAction = searchHref(nav.primaryLinks)

const canonical = Astro.site
	? new URL(Astro.url.pathname, Astro.site).href
	: undefined
const absoluteOgImage = ogImage
	? /^https?:\/\//i.test(ogImage)
		? ogImage
		: Astro.site
			? new URL(ogImage, Astro.site).href
			: undefined
	: undefined
const twitterCard = absoluteOgImage ? 'summary_large_image' : 'summary'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		{description ? <meta name="description" content={description} /> : null}
		{noIndex ? <meta name="robots" content="noindex" /> : null}
		{canonical ? <link rel="canonical" href={canonical} /> : null}
		<meta property="og:site_name" content="Tredyffrin Easttown Historical Society" />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		{description ? <meta property="og:description" content={description} /> : null}
		{canonical ? <meta property="og:url" content={canonical} /> : null}
		{absoluteOgImage ? <meta property="og:image" content={absoluteOgImage} /> : null}
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={title} />
		{description ? <meta name="twitter:description" content={description} /> : null}
		{absoluteOgImage ? <meta name="twitter:image" content={absoluteOgImage} /> : null}
		<title>{title}</title>
	</head>
	<body class="flex min-h-full flex-col">
		<header
			class="sticky top-0 z-50 bg-surface/80 backdrop-blur-[20px]"
		>
			<nav
				class="mx-auto flex max-w-6xl items-center justify-between gap-8 px-8 py-4"
				aria-label="Main"
			>
				<a href="/" class="font-display text-lg tracking-[-0.015em] text-primary no-underline">
					TEHS
				</a>
				<div class="flex min-w-0 items-center gap-8">
					<Navlinks links={headerLinks} />
					{showSearch ? <Search action={searchAction} /> : null}
				</div>
			</nav>
		</header>
		<main class="mx-auto w-full max-w-6xl flex-1 px-8 py-12">
			<slot />
		</main>
		<ExploreFooter links={nav.secondaryLinks} />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
