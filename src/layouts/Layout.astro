---
import {Font} from 'astro:assets'
import '../styles/global.css'
import ExploreFooter from '../components/ExploreFooter.astro'
import SiteHeader from '../components/SiteHeader.astro'
import {absoluteUrl} from '../lib/href'
import {
	getSiteNavigation,
	hasSearchControl,
	pageLinks,
	searchHref,
} from '../lib/siteNavigation'

interface Props {
	title?: string
	description?: string
	ogImage?: string
	ogType?: 'website' | 'article'
	noIndex?: boolean
}

const {
	title = 'Tredyffrin Easttown Historical Society',
	description,
	ogImage,
	ogType = 'website',
	noIndex = false,
} = Astro.props

const nav = await getSiteNavigation()
const headerLinks = pageLinks(nav.primaryLinks)
const showSearch = hasSearchControl(nav.primaryLinks)
const searchAction = searchHref(nav.primaryLinks)

const canonical = absoluteUrl(Astro.url.pathname, Astro.site)
const absoluteOgImage = absoluteUrl(ogImage, Astro.site)
const twitterCard = absoluteOgImage ? 'summary_large_image' : 'summary'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		{description ? <meta name="description" content={description} /> : null}
		{noIndex ? <meta name="robots" content="noindex" /> : null}
		{canonical ? <link rel="canonical" href={canonical} /> : null}
		<meta property="og:site_name" content="Tredyffrin Easttown Historical Society" />
		<meta property="og:type" content={ogType} />
		<meta property="og:title" content={title} />
		{description ? <meta property="og:description" content={description} /> : null}
		{canonical ? <meta property="og:url" content={canonical} /> : null}
		{absoluteOgImage ? <meta property="og:image" content={absoluteOgImage} /> : null}
		<meta name="twitter:card" content={twitterCard} />
		<meta name="twitter:title" content={title} />
		{description ? <meta name="twitter:description" content={description} /> : null}
		{absoluteOgImage ? <meta name="twitter:image" content={absoluteOgImage} /> : null}
		<title>{title}</title>
		<Font cssVariable="--font-public-sans" preload />
		<Font cssVariable="--font-newsreader" preload />
	</head>
	<body class="flex min-h-full flex-col">
		<a
			href="#main"
			class:list={[
				'sr-only font-sans text-sm text-primary',
				'focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:z-60',
				'focus:rounded-sm focus:bg-surface-container-lowest focus:px-4 focus:py-2',
			]}
		>
			Skip to content
		</a>
		<SiteHeader
			links={headerLinks}
			showSearch={showSearch}
			searchAction={searchAction}
		/>
		<main
			id="main"
			tabindex="-1"
			class="mx-auto w-full max-w-7xl flex-1 scroll-mt-24 px-8 py-12"
		>
			<slot />
		</main>
		<ExploreFooter links={nav.secondaryLinks} />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
