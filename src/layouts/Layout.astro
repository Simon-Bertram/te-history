---
import '../styles/global.css'
import Navlinks from '../components/Navlinks.astro'
import Search from '../components/Search.astro'
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<title>Astro Basics</title>
	</head>
	<body>
		<header
			class="sticky top-0 z-50 border-b border-outline-variant/20 bg-surface/80 backdrop-blur-[20px]"
		>
			<nav
				class="mx-auto flex max-w-6xl items-center justify-between gap-8 px-8 py-4"
				aria-label="Main"
			>
				<a
					href="/"
					class="font-display text-lg tracking-[-0.015em] text-primary no-underline"
				>
					The Archive
				</a>
				<div class="flex min-w-0 items-center gap-8">
					<Navlinks />
					<Search />
				</div>
			</nav>
		</header>
		<slot />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
