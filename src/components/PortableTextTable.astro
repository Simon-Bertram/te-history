---
import {PortableText} from 'astro-portabletext'
import type {PortableTextProps} from 'astro-portabletext/types'

interface TableCell {
	_type: 'cell'
	_key: string
	value?: PortableTextProps['value'] | null
}

interface TableRow {
	_type: 'row'
	_key: string
	cells?: TableCell[] | null
}

interface Props {
	node: {
		_type?: 'table'
		headerRows?: number | null
		rows?: TableRow[] | null
	}
}

const {node} = Astro.props
const rows = node.rows?.filter(Boolean) ?? []
const headerRows =
	typeof node.headerRows === 'number' && node.headerRows > 0
		? node.headerRows
		: 0

const cellClass =
	'border border-outline-variant/20 px-3 py-2 align-top [&_p]:my-0 [&_p]:leading-snug'
const headerClass = `${cellClass} bg-surface-container-low font-medium text-on-surface`
const bodyClass = `${cellClass} text-on-surface`
---

{
	rows.length > 0 ? (
		<div class="not-prose my-8 overflow-x-auto">
			<table class="w-full border-collapse font-sans text-sm text-on-surface">
				{rows.map((row, rowIndex) => {
					const isHeader = rowIndex < headerRows
					const cells = row.cells ?? []
					return (
						<tr>
							{cells.map((cell) => {
								const content =
									cell.value &&
									(Array.isArray(cell.value)
										? cell.value.length > 0
										: true) ? (
										<PortableText value={cell.value} />
									) : null
								return isHeader ? (
									<th scope="col" class={headerClass}>
										{content}
									</th>
								) : (
									<td class={bodyClass}>{content}</td>
								)
							})}
						</tr>
					)
				})}
			</table>
		</div>
	) : null
}
