---
import {hrefFor} from '../lib/href'
import {catalogImageAlt} from '../lib/imageAlt'
import type {CatalogImageCard} from '../lib/imageHighlights'
import {
	GRID_IMAGE_WIDTHS,
	catalogGridSrc,
	hasCatalogImageAsset,
	srcsetFromWidths,
} from '../lib/imageUrl'

interface Props {
	images: CatalogImageCard[]
	empty?: string
	priorityCount?: number
}

const {
	images,
	empty = 'No images match these filters.',
	priorityCount = 0,
} = Astro.props

const sizes = '(min-width: 1024px) 33vw, (min-width: 640px) 50vw, calc(100vw - 4rem)'
---

{
	images.length === 0 ? (
		<p class="font-sans text-on-surface-variant">{empty}</p>
	) : (
		<ul class="m-0 grid list-none grid-cols-1 gap-8 p-0 sm:grid-cols-2 lg:grid-cols-3">
			{images.map((image, index) => {
				const file = image.imageFile
				const hasFile = hasCatalogImageAsset(file)
				const src = hasFile ? catalogGridSrc(file, 720) : undefined
				const srcset = hasFile
					? srcsetFromWidths(file, GRID_IMAGE_WIDTHS, catalogGridSrc)
					: undefined
				const href = hrefFor(
					{_type: 'historicalImage', archiveId: image.archiveId},
					'/images',
				)
				const isPriority = index < priorityCount
				return (
					<li class="bg-surface-container-low p-8 transition-[background-color,box-shadow] duration-200 hover:bg-surface-container-highest hover:shadow-[0_24px_48px_color-mix(in_srgb,var(--on-surface)_6%,transparent)]">
						<a href={href} class="no-underline text-inherit">
							{src ? (
								<img
									src={src}
									srcset={srcset}
									sizes={sizes}
									alt={catalogImageAlt({
										imageFile: file,
										title: image.title,
									})}
									width="720"
									height="540"
									class="mb-4 aspect-4/3 w-full object-cover"
									loading={isPriority ? 'eager' : 'lazy'}
									fetchpriority={isPriority ? 'high' : 'auto'}
								/>
							) : null}
							<p class="font-display text-lg text-on-surface">{image.title}</p>
							<p class="mt-1 font-sans text-sm tracking-[0.04em] text-on-surface-variant">
								{[image.archiveId, image.dateTaken?.year, image.township]
									.filter(Boolean)
									.join(' · ')}
							</p>
						</a>
					</li>
				)
			})}
		</ul>
	)
}
