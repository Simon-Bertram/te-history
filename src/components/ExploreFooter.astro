---
import type {NavLink} from '../lib/nav'
import {pageLinks} from '../lib/siteNavigation'

interface Props {
	links: NavLink[]
}

const {links} = Astro.props
const explore = pageLinks(links)
---

<footer class="mt-16 bg-surface-container-low">
	<div class="mx-auto flex max-w-6xl flex-col gap-6 px-8 py-10">
		<p class="font-display text-lg text-primary">Explore</p>
		<ul class="flex list-none flex-wrap gap-x-8 gap-y-3 p-0">
			{
				explore.map((link) => (
					<li>
						<a
							href={link.href}
							class="font-sans text-sm tracking-[0.04em] text-on-surface-variant no-underline hover:text-primary"
						>
							{link.label}
						</a>
					</li>
				))
			}
		</ul>
		<p class="font-sans text-xs tracking-[0.04em] text-on-surface-variant">
			Tredyffrin Easttown Historical Society
		</p>
	</div>
</footer>
