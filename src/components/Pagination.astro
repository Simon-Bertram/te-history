---
import {Icon} from 'astro-icon/components'

interface Props {
	page: number
	pageSize: number
	total: number
	basePath: string
	showPageLabel?: boolean
	summary?: string
	class?: string
	ariaLabel?: string
}

const {
	page,
	pageSize,
	total,
	basePath,
	showPageLabel = true,
	summary,
	class: className = 'mt-10',
	ariaLabel = 'Pagination',
} = Astro.props
const pageCount = Math.max(1, Math.ceil(total / pageSize))
const params = new URLSearchParams(Astro.url.search)
const hrefFor = (next: number) => {
	const nextParams = new URLSearchParams(params)
	if (next <= 1) nextParams.delete('page')
	else nextParams.set('page', String(next))
	const query = nextParams.toString()
	return query ? `${basePath}?${query}` : basePath
}
const centerLabel = summary ?? (showPageLabel ? `Page ${page} of ${pageCount}` : null)
const linkClass =
	'inline-flex items-center gap-1 text-secondary no-underline hover:underline focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-secondary'
const disabledClass =
	'inline-flex items-center gap-1 text-on-surface-variant opacity-50'
const iconClass = 'size-4 shrink-0'
---

{
	pageCount > 1 ? (
		<nav
			class:list={[className, 'flex items-center justify-between font-sans text-sm']}
			aria-label={ariaLabel}
		>
			{page > 1 ? (
				<a href={hrefFor(page - 1)} class={linkClass}>
					<Icon name="lucide:chevron-left" class={iconClass} aria-hidden="true" />
					Previous
				</a>
			) : (
				<span class={disabledClass} aria-disabled="true">
					<Icon name="lucide:chevron-left" class={iconClass} aria-hidden="true" />
					Previous
				</span>
			)}
			{centerLabel ? (
				<p class="text-center text-on-surface-variant">{centerLabel}</p>
			) : (
				<span />
			)}
			{page < pageCount ? (
				<a href={hrefFor(page + 1)} class={linkClass}>
					Next
					<Icon name="lucide:chevron-right" class={iconClass} aria-hidden="true" />
				</a>
			) : (
				<span class={disabledClass} aria-disabled="true">
					Next
					<Icon name="lucide:chevron-right" class={iconClass} aria-hidden="true" />
				</span>
			)}
		</nav>
	) : null
}
