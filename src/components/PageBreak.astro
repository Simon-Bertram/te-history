---
interface Props {
	node: {
		pageNumber?: string | null
	}
}

const {node} = Astro.props
const label = node.pageNumber ? `Page ${node.pageNumber}` : 'Page break'
---

<p
	class="my-10 border-t border-outline-variant/20 pt-4 text-center font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant"
	role="separator"
	aria-label={label}
>
	{label}
</p>
