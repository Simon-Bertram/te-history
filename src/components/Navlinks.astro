---
const links = [
  {
    label: "Home",
    href: "/",
  },
  {
    label: "About",
    href: "/about",
  },
];

const currentPath = Astro.url.pathname.replace(/\/$/, "") || "/";
const isActive = (href: string) =>
  (href.replace(/\/$/, "") || "/") === currentPath;
---

<ul class="flex list-none gap-8 p-0">
  {links.map((link) => (
    <li>
      <a
        href={link.href}
        aria-current={isActive(link.href) ? "page" : undefined}
        class:list={[
          "font-sans text-sm tracking-[0.04em] transition-colors",
          isActive(link.href)
            ? "font-medium text-primary underline decoration-primary-fixed underline-offset-4"
            : "text-on-surface-variant no-underline hover:text-primary",
        ]}
      >
        {link.label}
      </a>
    </li>
  ))}
</ul>
