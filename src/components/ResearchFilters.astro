---
import type {SubjectOption, TownshipOption} from '../lib/catalog'

interface Props {
	townships: TownshipOption[]
	subjects: SubjectOption[]
}

const {townships, subjects} = Astro.props
const q = Astro.url.searchParams.get('q') ?? ''
const township = Astro.url.searchParams.get('township') ?? ''
const subject = Astro.url.searchParams.get('subject') ?? ''
const inputClass =
	'rounded-sm bg-surface-container-lowest px-3 py-2 font-sans text-sm border-0 border-b border-outline-variant/40 focus:border-primary focus:outline-none'
---

<form
	class="mt-6 grid max-w-3xl gap-3 sm:grid-cols-[1fr_minmax(10rem,12rem)_minmax(10rem,12rem)_auto] sm:items-end"
	action="/research"
	method="get"
>
	<label class="flex min-w-0 flex-col gap-1 font-sans text-xs tracking-[0.04em] text-on-surface-variant">
		Title
		<input class={inputClass} type="search" name="q" value={q} />
	</label>
	<label class="flex min-w-0 flex-col gap-1 font-sans text-xs tracking-[0.04em] text-on-surface-variant">
		Township
		<select class={inputClass} name="township">
			<option value="">All</option>
			{townships.map((item) => (
				<option value={item._id} selected={township === item._id}>
					{item.name}
				</option>
			))}
		</select>
	</label>
	<label class="flex min-w-0 flex-col gap-1 font-sans text-xs tracking-[0.04em] text-on-surface-variant">
		Subject
		<select class={inputClass} name="subject">
			<option value="">All</option>
			{subjects.map((item) => (
				<option value={item._id} selected={subject === item._id}>
					{item.title}
				</option>
			))}
		</select>
	</label>
	<div class="flex items-end gap-3">
		<button type="submit" class="rounded-sm bg-primary px-4 py-2 font-sans text-sm text-on-primary">
			Filter
		</button>
		<a
			href="/research"
			class="link-quiet py-2 font-sans text-sm text-on-surface-variant hover:text-primary"
		>
			Clear filters
		</a>
	</div>
</form>
