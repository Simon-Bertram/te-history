---
import ArticleList from '../../components/ArticleList.astro'
import DocumentList from '../../components/DocumentList.astro'
import HubPage from '../../components/HubPage.astro'
import {getSubjectHubPaths} from '../../lib/subjects'

export async function getStaticPaths() {
	return getSubjectHubPaths()
}

const {subject} = Astro.props
---

<HubPage
	title={subject.title ?? subject._id}
	description={subject.description ?? `${subject.title} in the Tredyffrin Easttown historical catalog.`}
	parentHref="/subjects"
	parentLabel="Subjects"
	heading={subject.title ?? subject._id}
	images={subject.images ?? []}
	imageCount={subject.imageCount ?? 0}
	seeAllHref={`/images?subject=${subject._id}`}
	emptyImages="No photographs are tagged with this subject yet."
>
	{
		subject.description ? (
			<p slot="lede" class="mt-4 max-w-2xl font-sans text-on-surface-variant">
				{subject.description}
			</p>
		) : null
	}
	<DocumentList items={subject.documents ?? []} heading="Documents" />
	<ArticleList
		items={(subject.quarterly ?? []).map((article) => ({
			...article,
			_type: 'quarterlyArticle',
		}))}
		heading="Quarterly"
	/>
</HubPage>
