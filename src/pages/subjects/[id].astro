---
export const prerender = false

import ImageGrid from '../../components/ImageGrid.astro'
import Layout from '../../layouts/Layout.astro'
import {getSubjectHub} from '../../lib/collections'
import {ENTITY_IMAGE_STRIP} from '../../lib/limits'
import type {CatalogImage} from '../../lib/imageHighlights'

const id = Astro.params.id
if (!id) {
	return Astro.redirect('/subjects')
}

const subject = await getSubjectHub(id)
if (!subject) {
	return new Response(null, {status: 404, statusText: 'Not found'})
}
---

<Layout
	title={subject.title}
	description={subject.description ?? `${subject.title} in the Tredyffrin Easttown historical catalog.`}
>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">
		<a href="/subjects" class="text-on-surface-variant no-underline hover:text-primary">Subjects</a>
	</p>
	<h1 class="mt-3 text-display-sm">{subject.title}</h1>
	{subject.description ? (
		<p class="mt-4 max-w-2xl font-sans text-on-surface-variant">{subject.description}</p>
	) : null}

	<section class="mt-10">
		<div class="mb-6 flex items-end justify-between gap-4">
			<h2 class="text-2xl">Photographs</h2>
			{subject.imageCount > ENTITY_IMAGE_STRIP ? (
				<a href={`/images?subject=${subject._id}`} class="font-sans text-sm text-primary no-underline">
					See all {subject.imageCount} images
				</a>
			) : null}
		</div>
		<ImageGrid images={(subject.images ?? []) as CatalogImage[]} empty="No photographs are tagged with this subject yet." />
	</section>

	{
		subject.documents?.length ? (
			<section class="mt-12">
				<h2 class="text-2xl">Documents</h2>
				<ul class="mt-4 list-none p-0">
					{subject.documents.map((doc: { _id: string; title: string; archiveId?: string }) => (
						<li class="border-b border-outline-variant/20 py-3">
							<a
								href={doc.archiveId ? `/documents/${doc.archiveId}` : '/documents'}
								class="font-display text-xl text-on-surface no-underline hover:text-primary"
							>
								{doc.title}
							</a>
						</li>
					))}
				</ul>
			</section>
		) : null
	}

	{
		subject.quarterly?.length ? (
			<section class="mt-12">
				<h2 class="text-2xl">Quarterly</h2>
				<ul class="mt-4 list-none p-0">
					{subject.quarterly.map((article: { _id: string; title: string; sourceUrl?: string }) => (
						<li class="border-b border-outline-variant/20 py-3">
							{article.sourceUrl ? (
								<a href={article.sourceUrl} class="font-display text-xl text-on-surface no-underline hover:text-primary">
									{article.title}
								</a>
							) : (
								<span class="font-display text-xl">{article.title}</span>
							)}
						</li>
					))}
				</ul>
			</section>
		) : null
	}
</Layout>
