---
import Layout from '../../layouts/Layout.astro'
import PortableTextBody from '../../components/PortableTextBody.astro'
import {getImageStaticPaths} from '../../lib/catalog'
import {hrefFor} from '../../lib/href'
import {catalogImageAlt} from '../../lib/imageAlt'
import {
	DETAIL_IMAGE_WIDTHS,
	catalogDetailSrc,
	intrinsicSize,
	srcsetFromWidths,
} from '../../lib/imageUrl'

export async function getStaticPaths() {
	return getImageStaticPaths()
}

const {image} = Astro.props
const archiveId = image.archiveId ?? Astro.params.archiveId ?? ''
const file = image.imageFile
const src = file ? catalogDetailSrc(file, 1600) : undefined
const srcset = file ? srcsetFromWidths(file, DETAIL_IMAGE_WIDTHS, catalogDetailSrc) : undefined
const size = file ? intrinsicSize(file, 1600) : undefined
const alt = catalogImageAlt({imageFile: file, title: image.title})
---

<Layout
	title={image.title ?? archiveId}
	description={image.description ?? undefined}
	ogImage={src}
	ogType="article"
>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">
		<a href="/images" class="text-on-surface-variant no-underline hover:text-primary">Images</a>
		{' / '}
		{image.archiveId}
	</p>
	<h1 class="mt-3 text-display-sm">{image.title}</h1>
	{
		src && size ? (
			<img
				src={src}
				srcset={srcset}
				sizes="(min-width: 896px) 896px, calc(100vw - 4rem)"
				alt={alt}
				width={size.width}
				height={size.height}
				class="mt-8 h-auto w-full max-w-4xl"
				fetchpriority="high"
			/>
		) : null
	}
	{
		image.description ? (
			<p class="mt-6 max-w-2xl font-sans text-on-surface">{image.description}</p>
		) : null
	}
	<dl class="mt-8 grid max-w-xl gap-3 font-sans text-sm">
		{image.dateTaken?.year ? (
			<div>
				<dt class="text-on-surface-variant">Date</dt>
				<dd>{image.dateTaken.year}</dd>
			</div>
		) : null}
		{image.location || image.township ? (
			<div>
				<dt class="text-on-surface-variant">Place</dt>
				<dd>
					{image.location ? (
						<a href={hrefFor({_type: 'location', slug: image.location.slug, _id: image.location._id})} class="text-primary no-underline">
							{image.location.name}
						</a>
					) : null}
					{image.location && image.township ? `, ${image.township}` : null}
					{!image.location && image.township ? image.township : null}
				</dd>
			</div>
		) : null}
		{image.photographer ? (
			<div>
				<dt class="text-on-surface-variant">Photographer</dt>
				<dd>{image.photographer}</dd>
			</div>
		) : null}
		{image.contributor ? (
			<div>
				<dt class="text-on-surface-variant">Contributor</dt>
				<dd>{image.contributor}</dd>
			</div>
		) : null}
		{image.rights ? (
			<div>
				<dt class="text-on-surface-variant">Rights</dt>
				<dd>{image.rights}</dd>
			</div>
		) : null}
		{image.references?.length ? (
			<div>
				<dt class="text-on-surface-variant">References</dt>
				<dd>
					<div class="prose font-sans">
						<PortableTextBody value={image.references} />
					</div>
				</dd>
			</div>
		) : null}
	</dl>
	{
		image.people?.length ? (
			<section class="mt-8">
				<h2 class="text-xl">People</h2>
				<ul class="mt-2 list-none p-0">
					{image.people.map((person) => (
						<li>
							<a href={hrefFor({_type: 'person', slug: person.slug, _id: person._id})} class="text-primary no-underline">
								{[person.firstName, person.lastName].filter(Boolean).join(' ')}
							</a>
						</li>
					))}
				</ul>
			</section>
		) : null
	}
	{
		image.subjects?.length ? (
			<section class="mt-8">
				<h2 class="text-xl">Subjects</h2>
				<ul class="mt-2 flex list-none flex-wrap gap-2 p-0">
					{image.subjects.map((item) => (
						<li>
							<a
								href={hrefFor({_type: 'category', slug: item.slug, _id: item._id})}
								class="bg-secondary-fixed px-3 py-1 font-sans text-sm text-on-secondary-fixed no-underline"
							>
								{item.title}
							</a>
						</li>
					))}
				</ul>
			</section>
		) : null
	}
</Layout>
