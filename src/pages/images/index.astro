---
export const prerender = false

import CatalogResultsBar from '../../components/CatalogResultsBar.astro'
import FacetForm from '../../components/FacetForm.astro'
import ImageGrid from '../../components/ImageGrid.astro'
import Layout from '../../layouts/Layout.astro'
import {
	getFilteredImages,
	getHighlightImages,
	getLocations,
	getSubjects,
	getTownships,
} from '../../lib/catalog'
import {
	catalogPageCount,
	formatDisplayingRangeSummary,
} from '../../lib/catalogResults'
import {IMAGES_PAGE_SIZE, parsePage} from '../../lib/limits'
import {setSsrCacheControl} from '../../lib/ssrCache'

setSsrCacheControl(Astro.response.headers)

const params = Astro.url.searchParams
const q = params.get('q') ?? ''
const township = params.get('township') ?? ''
const location = params.get('location') ?? ''
const subject = params.get('subject') ?? ''
const decade = params.get('decade') ?? ''
const sort = params.get('sort') ?? ''
const all = params.get('all') === '1'
const page = parsePage(params.get('page') ?? undefined)
const hasCustomSort = Boolean(sort) && sort !== 'date-desc'
const hasFilters = Boolean(q || township || location || subject || decade || hasCustomSort || all)

const [townships, locations, subjects, filtered, highlights] = await Promise.all([
	getTownships(),
	getLocations(),
	getSubjects(),
	hasFilters
		? getFilteredImages({q, township, location, subject, decade, sort, page})
		: Promise.resolve(null),
	hasFilters ? Promise.resolve([]) : getHighlightImages(IMAGES_PAGE_SIZE),
])

const images = hasFilters ? (filtered?.images ?? []) : highlights
const total = hasFilters ? (filtered?.total ?? 0) : images.length
const pageCount = catalogPageCount(total, IMAGES_PAGE_SIZE)
const showNavigation = hasFilters && pageCount > 1
const resultsSummary = hasFilters
	? formatDisplayingRangeSummary({
			total,
			page,
			pageSize: IMAGES_PAGE_SIZE,
			singular: 'photograph',
			plural: 'photographs',
		})
	: `Displaying featured photos (${images.length.toLocaleString('en-US')})`
---

<Layout
	title="Image collection"
	description="Search historic photographs from Tredyffrin and Easttown by subject, township, and Archive ID."
>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">
		Image collection
	</p>
	<h1 class="mt-3 text-display-sm">Photographs</h1>
	<p class="mt-4 max-w-2xl font-sans text-on-surface-variant">
		The landing grid is a curated set of local views. Use the filters to search the full catalog,
		or <a href="/images?all=1" class="text-primary">browse all images</a>.
	</p>

	<FacetForm
		townships={townships ?? []}
		subjects={subjects ?? []}
		locations={locations ?? []}
		showPlace
		showSort
	/>

	<CatalogResultsBar
		summary={resultsSummary}
		page={page}
		pageSize={IMAGES_PAGE_SIZE}
		total={total}
		basePath="/images"
		showNavigation={showNavigation}
		class="mb-6"
		ariaLabel="Results pagination"
	/>

	{
		hasFilters && total === 0 ? (
			<p class="font-sans text-on-surface-variant">
				No images match these filters. <a href="/images" class="text-primary">Clear filters</a>
			</p>
		) : (
			<ImageGrid images={images} priorityCount={hasFilters ? 0 : 1} />
		)
	}

	{
		showNavigation ? (
			<CatalogResultsBar
				summary={resultsSummary}
				page={page}
				pageSize={IMAGES_PAGE_SIZE}
				total={total}
				basePath="/images"
				showNavigation
				class="mt-10"
				ariaLabel="Results pagination bottom"
			/>
		) : null
	}
</Layout>
