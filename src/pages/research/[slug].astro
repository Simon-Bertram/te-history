---
export const prerender = false

import {PortableText} from 'astro-portabletext'
import Layout from '../../layouts/Layout.astro'
import {getResearchBySlug} from '../../lib/collections'
import {rewriteNotFound} from '../../lib/notFound'

const slug = Astro.params.slug
if (!slug) {
	return Astro.redirect('/research')
}

const article = await getResearchBySlug(slug)
if (!article) {
	return rewriteNotFound(Astro)
}
---

<Layout title={article.title ?? slug}>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">
		<a href="/research" class="text-on-surface-variant no-underline hover:text-primary">Research</a>
	</p>
	<h1 class="mt-3 text-display-sm">{article.title}</h1>
	{
		article.body?.length ? (
			<div class="prose mt-8 max-w-3xl font-sans">
				<PortableText value={article.body} />
			</div>
		) : null
	}
	{
		article.notesAndReferences?.length ? (
			<section class="mt-16 bg-surface-dim p-8">
				<h2 class="text-2xl">Notes and references</h2>
				<div class="prose mt-4 max-w-3xl font-sans">
					<PortableText value={article.notesAndReferences} />
				</div>
			</section>
		) : null
	}
</Layout>
