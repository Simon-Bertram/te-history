---
import PortableTextBody from '../../components/PortableTextBody.astro'
import Layout from '../../layouts/Layout.astro'
import {getResearchStaticPaths} from '../../lib/research'

export async function getStaticPaths() {
	return getResearchStaticPaths()
}

const {article} = Astro.props
const slug = article.slug ?? Astro.params.slug ?? ''
---

<Layout title={article.title ?? slug} ogType="article">
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">
		<a href="/research" class="text-on-surface-variant no-underline hover:text-primary">Research</a>
	</p>
	<h1 class="mt-3 text-display-sm text-pretty">{article.title}</h1>
	{
		article.body?.length ? (
			<div class="prose prose-lg mt-8 max-w-2xl font-sans">
				<PortableTextBody value={article.body} />
			</div>
		) : null
	}
	{
		article.notesAndReferences?.length ? (
			<section class="mt-16 max-w-2xl bg-surface-dim p-8">
				<h2 class="text-2xl">Notes and references</h2>
				<div class="prose prose-lg mt-4 font-sans">
					<PortableTextBody value={article.notesAndReferences} />
				</div>
			</section>
		) : null
	}
</Layout>
