---
export const prerender = false

import ArticleList from '../../components/ArticleList.astro'
import CatalogActiveFilters from '../../components/CatalogActiveFilters.astro'
import ResearchFilters from '../../components/ResearchFilters.astro'
import Layout from '../../layouts/Layout.astro'
import {getSubjects, getTownships} from '../../lib/catalog'
import {sortSubjectsDemoteFuzzy, sortTownshipsFirst} from '../../lib/limits'
import {getResearchArticles} from '../../lib/research'
import {setSsrCacheControl} from '../../lib/ssrCache'

setSsrCacheControl(Astro.response.headers)

const township = Astro.url.searchParams.get('township') ?? ''
const subject = Astro.url.searchParams.get('subject') ?? ''
const q = Astro.url.searchParams.get('q') ?? ''
const [articles, townshipsRaw, subjectsRaw] = await Promise.all([
	getResearchArticles({townshipId: township, subjectId: subject, q}),
	getTownships(),
	getSubjects(),
])
const townships = sortTownshipsFirst(townshipsRaw ?? [])
const subjects = sortSubjectsDemoteFuzzy(subjectsRaw ?? [])
const hasFilters = Boolean(township.trim() || subject.trim() || q.trim())
const activeFilters = [
	q.trim() ? `“${q.trim()}”` : null,
	township
		? (townships.find((item) => item._id === township)?.name ?? 'Township')
		: null,
	subject
		? (subjects.find((item) => item._id === subject)?.title ?? 'Subject')
		: null,
].filter(Boolean) as string[]
---

<Layout
	title="Research"
	description="Township history and modern research articles from the Tredyffrin Easttown Historical Society."
>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">Research</p>
	<h1 class="mt-3 text-display-sm">Township history &amp; overviews</h1>
	<ResearchFilters townships={townships} subjects={subjects} />
	<CatalogActiveFilters class="mt-4" labels={activeFilters} clearHref="/research" />
	{
		(articles ?? []).length === 0 ? (
			<p class="mt-8 font-sans text-on-surface-variant">
				{hasFilters ? (
					<>
						No research articles match these filters.{' '}
						<a href="/research">Clear filters</a>
					</>
				) : (
					'No research articles are published yet.'
				)}
			</p>
		) : (
			<div class="mt-8">
				<ArticleList
					items={(articles ?? []).map((article) => ({
						...article,
						_type: 'researchArticle',
					}))}
				/>
			</div>
		)
	}
</Layout>
