---
export const prerender = false

import ArticleList from '../../components/ArticleList.astro'
import Layout from '../../layouts/Layout.astro'
import {getTownships} from '../../lib/catalog'
import {getResearchArticles} from '../../lib/research'
import {setSsrCacheControl} from '../../lib/ssrCache'

setSsrCacheControl(Astro.response.headers)

const township = Astro.url.searchParams.get('township') ?? ''
const [articles, townships] = await Promise.all([
	getResearchArticles(township),
	getTownships(),
])
---

<Layout
	title="Research"
	description="Township history and modern research articles from the Tredyffrin Easttown Historical Society."
>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">Research</p>
	<h1 class="mt-3 text-display-sm">Township history &amp; overviews</h1>
	<form class="mt-6 flex max-w-md items-end gap-3" action="/research" method="get">
		<label class="flex min-w-0 flex-1 flex-col gap-1 font-sans text-xs tracking-[0.04em] text-on-surface-variant">
			Township
			<select
				class="rounded-sm bg-surface-container-lowest px-3 py-2 font-sans text-sm border-0 border-b border-outline-variant/40"
				name="township"
			>
				<option value="">All</option>
				{(townships ?? []).map((item) => (
					<option value={item._id} selected={township === item._id}>
						{item.name}
					</option>
				))}
			</select>
		</label>
		<button type="submit" class="rounded-sm bg-primary px-4 py-2 font-sans text-sm text-on-primary">
			Filter
		</button>
	</form>
	<div class="mt-8">
		<ArticleList
			items={(articles ?? []).map((article) => ({
				...article,
				_type: 'researchArticle',
			}))}
		/>
	</div>
</Layout>
