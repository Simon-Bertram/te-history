---
export const prerender = false

import AlphabetFilterNav from '../../components/AlphabetFilterNav.astro'
import CatalogActiveFilters from '../../components/CatalogActiveFilters.astro'
import CatalogResultsBar from '../../components/CatalogResultsBar.astro'
import OrganizationsFilters from '../../components/OrganizationsFilters.astro'
import Layout from '../../layouts/Layout.astro'
import {getSubjects} from '../../lib/catalog'
import {
	catalogPageCount,
	formatCatalogResultsSummary,
} from '../../lib/catalogResults'
import {hrefFor} from '../../lib/href'
import {ORGANIZATIONS_PAGE_SIZE, parsePage, sortSubjectsDemoteFuzzy} from '../../lib/limits'
import {
	getOrganizationsPage,
	parseOrganizationKind,
	parseOrganizationLetter,
} from '../../lib/organizations'
import {setSsrCacheControl} from '../../lib/ssrCache'

setSsrCacheControl(Astro.response.headers)

const params = Astro.url.searchParams
const q = params.get('q') ?? ''
const subject = params.get('subject') ?? ''
const kind = parseOrganizationKind(params.get('kind') ?? undefined)
const letter = parseOrganizationLetter(params.get('letter') ?? undefined)
const page = parsePage(params.get('page') ?? undefined)

const [subjectsRaw, result] = await Promise.all([
	getSubjects(),
	getOrganizationsPage({q, subject, kind, letter, page}),
])
const subjects = sortSubjectsDemoteFuzzy(subjectsRaw ?? [])

const total = result?.total ?? 0
const pageCount = catalogPageCount(total, ORGANIZATIONS_PAGE_SIZE)
const showNavigation = pageCount > 1
const resultsSummary = formatCatalogResultsSummary({
	total,
	page,
	pageSize: ORGANIZATIONS_PAGE_SIZE,
	singular: kind === 'business' ? 'business' : kind === 'organization' ? 'organization' : 'entry',
	plural:
		kind === 'business'
			? 'businesses'
			: kind === 'organization'
				? 'organizations'
				: 'organizations and businesses',
	pageInSummary: showNavigation,
})

const activeFilters = [
	q.trim() ? `“${q.trim()}”` : null,
	kind === 'organization' ? 'Organizations' : kind === 'business' ? 'Businesses' : null,
	subject
		? (subjects.find((item) => item._id === subject)?.title ?? 'Subject')
		: null,
	letter ? (letter === '#' ? 'Letter Other' : `Letter ${letter}`) : null,
].filter(Boolean) as string[]

function activeYears(from?: number | null, to?: number | null) {
	if (from && to) return `${from}–${to}`
	if (from) return `${from}–`
	if (to) return `–${to}`
	return ''
}

function subjectMeta(item: {
	subjectTitle?: string | null
	subjectCount?: number | null
}) {
	const title = item.subjectTitle?.trim()
	if (!title) return ''
	const extra = (item.subjectCount ?? 0) > 1 ? ` +${(item.subjectCount ?? 0) - 1}` : ''
	return `${title}${extra}`
}

function kindLabel(type: string | null | undefined) {
	return type === 'business' ? 'Business' : 'Organization'
}
---

<Layout
	title="Organizations"
	description="Businesses and organizations in the Tredyffrin Easttown historical catalog."
>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">
		Organizations
	</p>
	<h1 class="mt-3 text-display-sm">Organizations</h1>
	<p class="mt-4 max-w-2xl font-sans text-on-surface-variant">
		Civic groups, institutions, and commercial firms share this directory. Search by name, filter
		by kind or subject, or jump by letter.
	</p>

	<OrganizationsFilters subjects={subjects} kind={kind} letter={letter} />

	<AlphabetFilterNav
		basePath="/organizations"
		letter={letter}
		preserveParams={{
			q,
			subject,
			kind: kind ?? '',
		}}
	/>

	<CatalogActiveFilters labels={activeFilters} clearHref="/organizations" />

	<CatalogResultsBar
		summary={resultsSummary}
		page={page}
		pageSize={ORGANIZATIONS_PAGE_SIZE}
		total={total}
		basePath="/organizations"
		showNavigation={showNavigation}
		class="mb-6"
		ariaLabel="Results pagination"
	/>

	{
		total === 0 ? (
			<p class="font-sans text-on-surface-variant">
				No organizations match these filters.{' '}
				<a href="/organizations">Clear filters</a>
			</p>
		) : (
			<ul class="list-none p-0">
				{(result?.organizations ?? []).map((item) => {
					const years = activeYears(item.activeFrom, item.activeTo)
					const subjectLabel = subjectMeta(item)
					const meta = [
						kindLabel(item._type),
						years || null,
						subjectLabel || null,
					].filter(Boolean)
					return (
						<li class="border-b border-outline-variant/20 py-3">
							<a
								href={hrefFor({
									_type: item._type,
									slug: item.slug,
									_id: item._id,
								})}
								class="link-quiet font-display text-xl text-on-surface hover:text-primary"
							>
								{item.name}
							</a>
							{meta.length ? (
								<span class="font-sans text-sm text-on-surface-variant">
									{' '}
									· {meta.join(' · ')}
								</span>
							) : null}
						</li>
					)
				})}
			</ul>
		)
	}

	{
		showNavigation ? (
			<CatalogResultsBar
				summary={resultsSummary}
				page={page}
				pageSize={ORGANIZATIONS_PAGE_SIZE}
				total={total}
				basePath="/organizations"
				showNavigation
				class="mt-10"
				ariaLabel="Results pagination bottom"
			/>
		) : null
	}
</Layout>
