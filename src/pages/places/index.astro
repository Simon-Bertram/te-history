---
import Layout from '../../layouts/Layout.astro'
import {hrefFor} from '../../lib/href'
import {sortTownshipsFirst} from '../../lib/limits'
import {getPlaces} from '../../lib/places'

const places = await getPlaces()
const townships = sortTownshipsFirst(places?.townships ?? [])
---

<Layout
	title="Places"
	description="Tredyffrin, Easttown, and named villages in the historical catalog."
>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">Places</p>
	<h1 class="mt-3 text-display-sm">Townships &amp; villages</h1>
	<p class="mt-4 max-w-2xl font-sans text-on-surface-variant">
		Start with Tredyffrin and Easttown, then named places such as Paoli, Berwyn, and Valley Forge.
	</p>
	<h2 class="mt-10 text-2xl">Townships</h2>
	<ul class="mt-4 list-none p-0">
		{
			townships.map((item) => (
				<li class="py-2">
					<a href={hrefFor({_type: 'township', _id: item._id})} class="font-display text-xl text-on-surface no-underline hover:text-primary">
						{item.name}
					</a>
				</li>
			))
		}
	</ul>
	<h2 class="mt-10 text-2xl">Villages &amp; named places</h2>
	<ul class="mt-4 list-none p-0">
		{
			(places?.locations ?? []).map((item) => (
				<li class="border-b border-outline-variant/20 py-3">
					<a href={hrefFor({_type: 'location', _id: item._id})} class="font-display text-xl text-on-surface no-underline hover:text-primary">
						{item.name}
					</a>
					{item.townships?.length ? (
						<span class="font-sans text-sm text-on-surface-variant">
							{' '}
							· {item.townships.join(', ')}
						</span>
					) : null}
				</li>
			))
		}
	</ul>
</Layout>
