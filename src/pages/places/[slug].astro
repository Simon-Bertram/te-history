---
import ArticleList from '../../components/ArticleList.astro'
import DocumentList from '../../components/DocumentList.astro'
import HubPage from '../../components/HubPage.astro'
import {getPlaceHubPaths} from '../../lib/places'

export async function getStaticPaths() {
	return getPlaceHubPaths()
}

const {place} = Astro.props
const kind = place._type === 'township' ? 'Township' : 'Place'
const facet = place._type === 'township' ? 'township' : 'location'
---

<HubPage
	title={place.name ?? place._id}
	description={`${place.name} in the Tredyffrin Easttown historical catalog.`}
	parentHref="/places"
	parentLabel="Places"
	crumb={kind}
	heading={place.name ?? place._id}
	images={place.images ?? []}
	imageCount={place.imageCount ?? 0}
	seeAllHref={`/images?${facet}=${place._id}`}
	emptyImages="No photographs are linked here yet."
>
	{
		place.townships?.length ? (
			<p slot="lede" class="mt-2 font-sans text-on-surface-variant">
				{place.townships.join(', ')}
			</p>
		) : null
	}
	<DocumentList items={place.documents ?? []} heading="Documents" />
	<ArticleList
		items={(place.research ?? []).map((article) => ({
			...article,
			_type: 'researchArticle',
		}))}
		heading="Research"
	/>
</HubPage>
