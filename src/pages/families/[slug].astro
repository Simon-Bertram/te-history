---
import HubPage from '../../components/HubPage.astro'
import {getFamilyHubPaths} from '../../lib/families'
import {hrefFor} from '../../lib/href'

export async function getStaticPaths() {
	return getFamilyHubPaths()
}

const {family} = Astro.props
const title = family.title ?? family._id
const people = family.people ?? []
---

<HubPage
	title={title}
	description={family.description ?? undefined}
	parentHref="/families"
	parentLabel="Families"
	heading={title}
	images={family.images ?? []}
	imageCount={family.imageCount ?? 0}
	seeAllHref={`/search?q=${encodeURIComponent(title)}`}
	emptyImages="No photographs are linked to this family line yet."
>
	{
		family.description ? (
			<p slot="lede" class="mt-4 max-w-2xl font-sans text-on-surface-variant">
				{family.description}
			</p>
		) : null
	}

	<section class="mt-12">
		<h2 class="text-2xl">People</h2>
		{
			people.length === 0 ? (
				<p class="mt-4 font-sans text-on-surface-variant">
					No publicly linked people are tagged with this family line yet.
				</p>
			) : (
				<ul class="mt-4 list-none p-0">
					{people.map((person) => (
						<li class="border-b border-outline-variant/20 py-3">
							<a
								href={hrefFor({
									_type: 'person',
									slug: person.slug,
									_id: person._id,
								})}
								class="link-quiet font-display text-xl text-on-surface hover:text-primary"
							>
								{[person.lastName, person.firstName].filter(Boolean).join(', ')}
							</a>
							<span class="font-sans text-sm text-on-surface-variant">
								{' '}
								· {person.imageCount ?? 0} photograph
								{(person.imageCount ?? 0) === 1 ? '' : 's'}
							</span>
						</li>
					))}
				</ul>
			)
		}
	</section>
</HubPage>
