---
export const prerender = false

import CatalogResultsBar from '../../components/CatalogResultsBar.astro'
import Layout from '../../layouts/Layout.astro'
import {getTownships} from '../../lib/catalog'
import {
	catalogPageCount,
	formatCatalogResultsSummary,
} from '../../lib/catalogResults'
import {hrefFor} from '../../lib/href'
import {parsePage, PROPERTIES_PAGE_SIZE, sortTownshipsFirst} from '../../lib/limits'
import {
	getPropertiesPage,
	parsePropertyLetter,
	PROPERTY_TYPES,
	propertyTypeLabel,
} from '../../lib/properties'
import {setSsrCacheControl} from '../../lib/ssrCache'

setSsrCacheControl(Astro.response.headers)

const params = Astro.url.searchParams
const q = params.get('q') ?? ''
const type = params.get('type') ?? ''
const township = params.get('township') ?? ''
const letter = parsePropertyLetter(params.get('letter') ?? undefined)
const page = parsePage(params.get('page') ?? undefined)

const [townshipsRaw, result] = await Promise.all([
	getTownships(),
	getPropertiesPage({q, type, township, letter, page}),
])
const townships = sortTownshipsFirst(townshipsRaw ?? [])

const total = result?.total ?? 0
const pageCount = catalogPageCount(total, PROPERTIES_PAGE_SIZE)
const showNavigation = pageCount > 1
const resultsSummary = formatCatalogResultsSummary({
	total,
	page,
	pageSize: PROPERTIES_PAGE_SIZE,
	singular: 'property',
	plural: 'properties',
	pageInSummary: showNavigation,
})

const inputClass =
	'rounded-sm bg-surface-container-lowest px-3 py-2 font-sans text-sm border-0 border-b border-outline-variant/40 focus:border-primary focus:outline-none'

const LETTERS = [
	...'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split(''),
	'#',
] as const

function activeLetterHref(next: string) {
	const nextParams = new URLSearchParams()
	if (q.trim()) nextParams.set('q', q.trim())
	if (type.trim()) nextParams.set('type', type.trim())
	if (township.trim()) nextParams.set('township', township.trim())
	if (next !== letter) nextParams.set('letter', next)
	const query = nextParams.toString()
	return query ? `/properties?${query}` : '/properties'
}

function placeMeta(item: {
	locationName?: string | null
	townshipName?: string | null
}) {
	return [item.locationName, item.townshipName].filter(Boolean).join(', ')
}
---

<Layout
	title="Properties"
	description="Houses, estates, churches, inns, and other buildings in the Tredyffrin Easttown historical catalog."
>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">
		Properties
	</p>
	<h1 class="mt-3 text-display-sm">Properties &amp; buildings</h1>
	<p class="mt-4 max-w-2xl font-sans text-on-surface-variant">
		Named houses, farms, churches, inns, and industrial sites. Search by historical name or browse
		by type, township, and letter.
	</p>

	<form
		class="mb-6 grid gap-4 bg-surface-container-low p-6 sm:grid-cols-2 lg:grid-cols-4"
		action="/properties"
		method="get"
	>
		<label class="flex flex-col gap-1 font-sans text-xs tracking-[0.04em] text-on-surface-variant">
			Name
			<input class={inputClass} type="search" name="q" value={q} />
		</label>
		<label class="flex flex-col gap-1 font-sans text-xs tracking-[0.04em] text-on-surface-variant">
			Property type
			<select class={inputClass} name="type">
				<option value="">All</option>
				{PROPERTY_TYPES.map((item) => (
					<option value={item.value} selected={type === item.value}>
						{item.label}
					</option>
				))}
			</select>
		</label>
		<label class="flex flex-col gap-1 font-sans text-xs tracking-[0.04em] text-on-surface-variant">
			Township
			<select class={inputClass} name="township">
				<option value="">All</option>
				{townships.map((item) => (
					<option value={item._id} selected={township === item._id}>
						{item.name}
					</option>
				))}
			</select>
		</label>
		{
			letter ? <input type="hidden" name="letter" value={letter} /> : null
		}
		<div class="flex items-end">
			<button
				type="submit"
				class="rounded-sm bg-primary px-4 py-2 font-sans text-sm text-on-primary"
			>
				Apply
			</button>
		</div>
	</form>

	<nav class="mb-8 flex flex-wrap gap-2 font-sans text-sm" aria-label="Alphabet">
		{LETTERS.map((item) => {
			const active = letter === item
			return (
				<a
					href={activeLetterHref(item)}
					class:list={[
						'link-quiet',
						active ? 'text-primary underline' : 'text-on-surface-variant hover:text-primary',
					]}
					aria-current={active ? 'true' : undefined}
				>
					{item === '#' ? 'Other' : item}
				</a>
			)
		})}
	</nav>

	<CatalogResultsBar
		summary={resultsSummary}
		page={page}
		pageSize={PROPERTIES_PAGE_SIZE}
		total={total}
		basePath="/properties"
		showNavigation={showNavigation}
		class="mb-6"
		ariaLabel="Results pagination"
	/>

	{
		total === 0 ? (
			<p class="font-sans text-on-surface-variant">
				No properties match these filters.{' '}
				<a href="/properties">Clear filters</a>
			</p>
		) : (
			<ul class="list-none p-0">
				{(result?.properties ?? []).map((item) => {
					const typeLabel = propertyTypeLabel(item.propertyType)
					const place = placeMeta(item)
					const meta = [
						typeLabel || null,
						item.yearBuilt != null ? String(item.yearBuilt) : null,
						place || null,
					].filter(Boolean)
					return (
						<li class="border-b border-outline-variant/20 py-3">
							<a
								href={hrefFor({
									_type: 'property',
									slug: item.slug,
									_id: item._id,
								})}
								class="link-quiet font-display text-xl text-on-surface hover:text-primary"
							>
								{item.historicalName}
							</a>
							{meta.length ? (
								<span class="font-sans text-sm text-on-surface-variant">
									{' '}
									· {meta.join(' · ')}
								</span>
							) : null}
						</li>
					)
				})}
			</ul>
		)
	}

	{
		showNavigation ? (
			<CatalogResultsBar
				summary={resultsSummary}
				page={page}
				pageSize={PROPERTIES_PAGE_SIZE}
				total={total}
				basePath="/properties"
				showNavigation
				class="mt-10"
				ariaLabel="Results pagination bottom"
			/>
		) : null
	}
</Layout>
