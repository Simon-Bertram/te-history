---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import {getLinkedPeople, type LinkedPerson} from '../../lib/collections'

function letterOf(person: LinkedPerson): string {
	const raw = (person.lastName ?? person.firstName ?? '?').slice(0, 1).toUpperCase()
	return /[A-Z]/.test(raw) ? raw : '#'
}

const people = await getLinkedPeople()
const grouped = new Map<string, LinkedPerson[]>()
for (const person of people ?? []) {
	const letter = letterOf(person)
	const members = grouped.get(letter) ?? []
	members.push(person)
	grouped.set(letter, members)
}
const groups = [...grouped.entries()]
---

<Layout
	title="People"
	description="People depicted in photographs or mentioned in the catalog. Empty name-index stubs are omitted."
>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">People</p>
	<h1 class="mt-3 text-display-sm">A–Z</h1>
	<p class="mt-4 max-w-2xl font-sans text-on-surface-variant">
		Only people linked to at least one photograph, document, or article are listed, so empty
		landowner stubs stay off the public site.
	</p>
	{
		groups.length ? (
			<nav class="mt-6 flex flex-wrap gap-2 font-sans text-sm" aria-label="Alphabet">
				{groups.map(([letter]) => (
					<a href={`#letter-${letter}`} class="text-primary no-underline">
						{letter === '#' ? 'Other' : letter}
					</a>
				))}
			</nav>
		) : null
	}
	{
		groups.map(([letter, members]) => (
			<section class="mt-10">
				<h2
					id={`letter-${letter}`}
					class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant"
				>
					{letter === '#' ? 'Other' : letter}
				</h2>
				<ul class="mt-3 list-none p-0">
					{members.map((person) => (
						<li class="border-b border-outline-variant/20 py-3">
							<a
								href={`/people/${person._id}`}
								class="font-display text-xl text-on-surface no-underline hover:text-primary"
							>
								{[person.lastName, person.firstName].filter(Boolean).join(', ')}
							</a>
							<span class="font-sans text-sm text-on-surface-variant">
								{' '}
								· {person.imageCount} photograph{person.imageCount === 1 ? '' : 's'}
							</span>
						</li>
					))}
				</ul>
			</section>
		))
	}
</Layout>
