---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import {getLinkedPeople} from '../../lib/collections'

const people = await getLinkedPeople()
const letters = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ'.split('')
---

<Layout
	title="People"
	description="People depicted in photographs or mentioned in the catalog. Empty name-index stubs are omitted."
>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">People</p>
	<h1 class="mt-3 text-display-sm">A–Z</h1>
	<p class="mt-4 max-w-2xl font-sans text-on-surface-variant">
		Only people linked to at least one photograph, document, or article are listed, so empty
		landowner stubs stay off the public site.
	</p>
	<nav class="mt-6 flex flex-wrap gap-2 font-sans text-sm" aria-label="Alphabet">
		{
			letters.map((letter) => (
				<a href={`#letter-${letter}`} class="text-primary no-underline">
					{letter}
				</a>
			))
		}
	</nav>
	<ul class="mt-8 list-none p-0">
		{
			(people ?? []).map((person: { _id: string; firstName?: string; lastName?: string; imageCount?: number }) => {
				const letter = (person.lastName ?? person.firstName ?? '?').slice(0, 1).toUpperCase()
				return (
					<li class="border-b border-outline-variant/20 py-3" id={`letter-${letter}`}>
							<a href={`/people/${person._id}`} class="font-display text-xl text-on-surface no-underline hover:text-primary">
								{[person.lastName, person.firstName].filter(Boolean).join(', ')}
							</a>
						<span class="font-sans text-sm text-on-surface-variant">
							{' '}
							· {person.imageCount} photograph{person.imageCount === 1 ? '' : 's'}
						</span>
					</li>
				)
			})
		}
	</ul>
</Layout>
