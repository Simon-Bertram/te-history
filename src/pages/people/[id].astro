---
import ArticleList from '../../components/ArticleList.astro'
import DocumentList from '../../components/DocumentList.astro'
import HubPage from '../../components/HubPage.astro'
import {getPersonHubPaths} from '../../lib/people'

export async function getStaticPaths() {
	return getPersonHubPaths()
}

const {person} = Astro.props
const name = [person.firstName, person.lastName].filter(Boolean).join(' ')
---

<HubPage
	title={name}
	parentHref="/people"
	parentLabel="People"
	heading={name}
	images={person.images ?? []}
	imageCount={person.imageCount ?? 0}
	seeAllHref={`/search?q=${encodeURIComponent(name)}`}
>
	{
		person.born || person.died ? (
			<p slot="lede" class="mt-2 font-sans text-on-surface-variant">
				{[person.born, person.died].filter(Boolean).join(' – ')}
			</p>
		) : null
	}
	<DocumentList items={person.documents ?? []} heading="Documents" />
	<ArticleList items={person.articles ?? []} heading="Articles" />
</HubPage>
