---
export const prerender = false

import CatalogNotFound from '../../components/CatalogNotFound.astro'
import PortableTextBody from '../../components/PortableTextBody.astro'
import Layout from '../../layouts/Layout.astro'
import {getDocumentByArchiveId} from '../../lib/documents'
import {
	DETAIL_IMAGE_WIDTHS,
	catalogDetailSrc,
	hasCatalogImageAsset,
	intrinsicSize,
	srcsetFromWidths,
} from '../../lib/imageUrl'
import {rewriteNotFound} from '../../lib/notFound'
import {setSsrCacheControl} from '../../lib/ssrCache'

setSsrCacheControl(Astro.response.headers)

const archiveId = Astro.params.archiveId ?? ''
const doc = archiveId ? await getDocumentByArchiveId(archiveId) : null
if (!doc) rewriteNotFound(Astro)

const scan = doc?.articleImage
const hasScan = hasCatalogImageAsset(scan)
const src = hasScan ? catalogDetailSrc(scan, 1200) : undefined
const srcset = hasScan ? srcsetFromWidths(scan, DETAIL_IMAGE_WIDTHS, catalogDetailSrc) : undefined
const size = hasScan ? intrinsicSize(scan, 1200) : undefined
---

{
	!doc ? (
		<Layout
			title="Page not found"
			description="This catalog page does not exist in the Tredyffrin Easttown Historical Society collections."
			noIndex
		>
			<CatalogNotFound />
		</Layout>
	) : (
		<Layout title={doc.title ?? archiveId} ogImage={src} ogType="article">
			<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">
				<a href="/documents" class="text-on-surface-variant no-underline hover:text-primary">
					Documents
				</a>
				{' / '}
				{doc.archiveId}
			</p>
			<h1 class="mt-3 text-display-sm text-pretty">{doc.title}</h1>
			<p class="mt-2 font-sans text-body-sm text-on-surface-variant">
				{[doc.newspaper, doc.date?.year].filter(Boolean).join(' · ')}
			</p>
			{src && size ? (
				<img
					src={src}
					srcset={srcset}
					sizes="(min-width: 768px) 768px, calc(100vw - 4rem)"
					alt=""
					width={size.width}
					height={size.height}
					class="mt-8 h-auto w-full max-w-3xl"
				/>
			) : null}
			{doc.transcription?.length ? (
				<div class="prose prose-lg mt-8 max-w-2xl font-sans">
					<PortableTextBody value={doc.transcription} />
				</div>
			) : null}
		</Layout>
	)
}
