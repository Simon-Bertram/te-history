---
export const prerender = false

import {PortableText} from 'astro-portabletext'
import Layout from '../../layouts/Layout.astro'
import {getDocumentByArchiveId} from '../../lib/collections'
import {urlFor} from '../../lib/imageUrl'

const archiveId = Astro.params.archiveId
if (!archiveId) {
	return Astro.redirect('/documents')
}

const doc = await getDocumentByArchiveId(archiveId)
if (!doc) {
	return new Response(null, {status: 404, statusText: 'Not found'})
}

const scan = doc.articleImage
	? urlFor(doc.articleImage).width(1200).fit('max').url()
	: undefined
---

<Layout title={doc.title ?? archiveId}>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">
		<a href="/documents" class="text-on-surface-variant no-underline hover:text-primary">
			Documents
		</a>
		{' / '}
		{doc.archiveId}
	</p>
	<h1 class="mt-3 text-display-sm">{doc.title}</h1>
	<p class="mt-2 font-sans text-on-surface-variant">
		{[doc.newspaper, doc.date?.year].filter(Boolean).join(' · ')}
	</p>
	{scan ? <img src={scan} alt="" class="mt-8 w-full max-w-3xl" /> : null}
	{
		doc.transcription?.length ? (
			<div class="prose mt-8 max-w-2xl font-sans">
				<PortableText value={doc.transcription} />
			</div>
		) : null
	}
</Layout>
