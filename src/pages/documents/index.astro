---
export const prerender = false

import CatalogResultsBar from '../../components/CatalogResultsBar.astro'
import DocumentList from '../../components/DocumentList.astro'
import FacetForm from '../../components/FacetForm.astro'
import Layout from '../../layouts/Layout.astro'
import {getSubjects, getTownships} from '../../lib/catalog'
import {
	catalogPageCount,
	formatCatalogResultsSummary,
} from '../../lib/catalogResults'
import {getDocumentsPage} from '../../lib/documents'
import {DOCUMENTS_PAGE_SIZE, parsePage, sortSubjectsDemoteFuzzy, sortTownshipsFirst} from '../../lib/limits'
import {setSsrCacheControl} from '../../lib/ssrCache'

setSsrCacheControl(Astro.response.headers)

const params = Astro.url.searchParams
const q = params.get('q') ?? ''
const township = params.get('township') ?? ''
const subject = params.get('subject') ?? ''
const decade = params.get('decade') ?? ''
const page = parsePage(params.get('page') ?? undefined)

const [townshipsRaw, subjectsRaw, result] = await Promise.all([
	getTownships(),
	getSubjects(),
	getDocumentsPage({q, township, subject, decade, page}),
])
const townships = sortTownshipsFirst(townshipsRaw ?? [])
const subjects = sortSubjectsDemoteFuzzy(subjectsRaw ?? [])

const total = result?.total ?? 0
const pageCount = catalogPageCount(total, DOCUMENTS_PAGE_SIZE)
const showNavigation = pageCount > 1
const resultsSummary = formatCatalogResultsSummary({
	total,
	page,
	pageSize: DOCUMENTS_PAGE_SIZE,
	singular: 'document',
	plural: 'documents',
	pageInSummary: showNavigation,
})

const activeFilters = [
	q.trim() ? `“${q.trim()}”` : null,
	township
		? (townships.find((item) => item._id === township)?.name ?? 'Township')
		: null,
	subject
		? (subjects.find((item) => item._id === subject)?.title ?? 'Subject')
		: null,
	decade ? `${decade}s` : null,
].filter(Boolean)
---

<Layout
	title="Document collection"
	description="Newspaper clippings, letters, and transcriptions from the Tredyffrin Easttown Historical Society."
>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">
		Document collection
	</p>
	<h1 class="mt-3 text-display-sm">Documents</h1>
	<p class="mt-4 max-w-2xl font-sans text-on-surface-variant">
		Clippings and transcriptions, searchable by the same townships and subjects as the photographs.
	</p>

	<FacetForm townships={townships} subjects={subjects} action="/documents" />

	{
		activeFilters.length ? (
			<p class="mb-4 font-sans text-sm text-on-surface-variant">
				Filtered by {activeFilters.join(' · ')}.{' '}
				<a href="/documents">Clear filters</a>
			</p>
		) : null
	}

	<CatalogResultsBar
		summary={resultsSummary}
		page={page}
		pageSize={DOCUMENTS_PAGE_SIZE}
		total={total}
		basePath="/documents"
		showNavigation={showNavigation}
		class="mb-6"
		ariaLabel="Results pagination"
	/>

	{
		total === 0 ? (
			<p class="font-sans text-on-surface-variant">
				No documents match these filters. <a href="/documents">Clear filters</a>
			</p>
		) : (
			<DocumentList items={result?.documents ?? []} showMeta />
		)
	}

	{
		showNavigation ? (
			<CatalogResultsBar
				summary={resultsSummary}
				page={page}
				pageSize={DOCUMENTS_PAGE_SIZE}
				total={total}
				basePath="/documents"
				showNavigation
				class="mt-10"
				ariaLabel="Results pagination bottom"
			/>
		) : null
	}
</Layout>
