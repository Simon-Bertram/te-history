---
export const prerender = false

import Layout from '../../layouts/Layout.astro'
import {getQuarterlyIssues} from '../../lib/collections'

const issues = await getQuarterlyIssues()
---

<Layout
	title="History Quarterly"
	description="Volume index for the Tredyffrin Easttown History Quarterly digital archives."
>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">
		History Quarterly
	</p>
	<h1 class="mt-3 text-display-sm">Volume index</h1>
	{
		(issues ?? []).map((issue) => {
			const articles = issue.articles ?? []
			return (
				<section class="mt-10">
					<h2 class="text-2xl">
						Volume {issue.volume}, Number {issue.issueNumber}
						{issue.season ? (
							<span class="font-sans text-lg text-on-surface-variant"> · {issue.season}</span>
						) : null}
					</h2>
					{articles.length ? (
						<ul class="mt-4 list-none p-0">
							{articles.map((article) => (
								<li class="border-b border-outline-variant/20 py-3 font-sans">
									{article.sourceUrl ? (
										<a
											href={article.sourceUrl}
											class="font-display text-xl text-on-surface no-underline hover:text-primary"
											rel="noreferrer noopener"
										>
											{article.title}
										</a>
									) : (
										<span class="font-display text-xl">{article.title}</span>
									)}
									{article.authorText ? (
										<span class="text-on-surface-variant"> — {article.authorText}</span>
									) : null}
								</li>
							))}
						</ul>
					) : null}
				</section>
			)
		})
	}
</Layout>
