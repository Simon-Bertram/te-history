---
import ArticleList from '../../components/ArticleList.astro'
import Layout from '../../layouts/Layout.astro'
import {getQuarterlyIssues} from '../../lib/quarterly'

const issues = await getQuarterlyIssues()
const initialQuery = Astro.url.searchParams.get('q') ?? ''
---

<Layout
	title="History Quarterly"
	description="Volume index for the Tredyffrin Easttown History Quarterly digital archives."
>
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">
		History Quarterly
	</p>
	<h1 class="mt-3 text-display-sm">Volume index</h1>

	<div data-quarterly-index>
		<div
			class:list={[
				'sticky top-[4.75rem] z-40 -mx-2 mt-6 px-2 py-3',
				'bg-surface/90 backdrop-blur-[20px]',
			]}
		>
			<form id="quarterly-filter-form" role="search">
				<label class="sr-only" for="quarterly-filter">
					Filter by title, author, volume, or year
				</label>
				<input
					id="quarterly-filter"
					type="search"
					name="q"
					value={initialQuery}
					placeholder="Filter by title, author, volume, or year…"
					autocomplete="off"
					enterkeyhint="search"
					aria-controls="quarterly-index-list"
					class:list={[
						'w-full max-w-xl rounded-sm bg-surface-container-lowest px-3 py-2',
						'font-sans text-sm text-on-surface tracking-[0.02em]',
						'placeholder:text-on-surface-variant/70',
						'border-0 border-b border-outline-variant/40',
						'transition-[border-color,box-shadow] duration-200',
						'focus:border-primary focus:outline-none',
						'focus:shadow-[0_0_12px_color-mix(in_srgb,var(--primary-container)_28%,transparent)]',
					]}
				/>
			</form>
			<p
				id="quarterly-filter-status"
				class="mt-2 font-sans text-sm text-on-surface-variant"
				aria-live="polite"
			></p>
		</div>

		<div id="quarterly-index-list">
			{
				(issues ?? []).map((issue) => {
					const articles = (issue.articles ?? []).map((article) => ({
						...article,
						_type: 'quarterlyArticle',
					}))
					const year = issue.publicationDate?.year
					return (
						<section
							class="mt-10"
							data-quarterly-issue
							data-year={year != null ? String(year) : undefined}
						>
							<h2 class="text-2xl mt-6" data-quarterly-heading>
								Volume {issue.volume}, Number {issue.issueNumber}
								{issue.season ? (
									<span class="font-sans text-lg text-on-surface-variant">
										{' '}
										· {issue.season}
									</span>
								) : null}
								{year != null ? (
									<span class="font-sans text-lg text-on-surface-variant">
										{' '}
										· {year}
									</span>
								) : null}
							</h2>
							<div class="mt-4">
								<ArticleList items={articles} />
							</div>
						</section>
					)
				})
			}
		</div>
	</div>
</Layout>

<script>
	const root = document.querySelector<HTMLElement>('[data-quarterly-index]')
	const form = document.querySelector<HTMLFormElement>('#quarterly-filter-form')
	const input = document.querySelector<HTMLInputElement>('#quarterly-filter')
	const status = document.querySelector<HTMLElement>('#quarterly-filter-status')
	const sections = root
		? Array.from(root.querySelectorAll<HTMLElement>('[data-quarterly-issue]'))
		: []

	form?.addEventListener('submit', (event) => {
		event.preventDefault()
	})

	function normalize(value: string) {
		return value.trim().toLowerCase()
	}

	function isYearQuery(query: string) {
		return /^[0-9]{1,4}$/.test(query)
	}

	function syncUrl(query: string) {
		const url = new URL(window.location.href)
		if (query) {
			url.searchParams.set('q', query)
		} else {
			url.searchParams.delete('q')
		}
		const next = `${url.pathname}${url.search}${url.hash}`
		const current = `${window.location.pathname}${window.location.search}${window.location.hash}`
		if (next !== current) {
			history.replaceState(null, '', next)
		}
	}

	function setHidden(el: HTMLElement, hidden: boolean) {
		el.hidden = hidden
	}

	function applyFilter(rawQuery: string) {
		const query = normalize(rawQuery)
		const yearMode = isYearQuery(query)

		let visibleArticles = 0
		let visibleVolumes = 0

		for (const section of sections) {
			const heading = section.querySelector<HTMLElement>('[data-quarterly-heading]')
			const items = Array.from(section.querySelectorAll<HTMLElement>('li'))
			const year = section.dataset.year ?? ''

			if (!query) {
				setHidden(section, false)
				for (const item of items) setHidden(item, false)
				visibleVolumes += 1
				visibleArticles += items.length
				continue
			}

			if (yearMode) {
				const yearMatch = year.length > 0 && year.startsWith(query)
				setHidden(section, !yearMatch)
				for (const item of items) setHidden(item, !yearMatch)
				if (yearMatch) {
					visibleVolumes += 1
					visibleArticles += items.length
				}
				continue
			}

			const headingText = normalize(heading?.textContent ?? '')
			const headingMatch = headingText.includes(query)

			if (headingMatch) {
				setHidden(section, false)
				for (const item of items) setHidden(item, false)
				visibleVolumes += 1
				visibleArticles += items.length
				continue
			}

			let matchedInSection = 0
			for (const item of items) {
				const match = normalize(item.textContent ?? '').includes(query)
				setHidden(item, !match)
				if (match) matchedInSection += 1
			}

			const sectionVisible = matchedInSection > 0
			setHidden(section, !sectionVisible)
			if (sectionVisible) {
				visibleVolumes += 1
				visibleArticles += matchedInSection
			}
		}

		if (!status) return

		if (!query) {
			status.textContent = ''
			return
		}

		if (visibleArticles === 0) {
			status.textContent = 'No matching articles'
			return
		}

		const articleLabel = visibleArticles === 1 ? 'article' : 'articles'
		const volumeLabel = visibleVolumes === 1 ? 'volume' : 'volumes'
		status.textContent = `Showing ${visibleArticles} ${articleLabel} in ${visibleVolumes} ${volumeLabel}`
	}

	if (input) {
		const initial = input.value
		applyFilter(initial)
		syncUrl(normalize(initial))

		input.addEventListener('input', () => {
			applyFilter(input.value)
			syncUrl(normalize(input.value))
		})

		input.addEventListener('keydown', (event) => {
			if (event.key !== 'Escape') return
			if (!input.value) return
			input.value = ''
			applyFilter('')
			syncUrl('')
		})
	}
</script>
