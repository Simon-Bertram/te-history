---
import PortableTextBody from '../../components/PortableTextBody.astro'
import Layout from '../../layouts/Layout.astro'
import {getQuarterlyArticleStaticPaths} from '../../lib/quarterly'

export async function getStaticPaths() {
	return getQuarterlyArticleStaticPaths()
}

const {article} = Astro.props
const slug = article.slug ?? Astro.params.slug ?? ''
const issue = article.issue
const volIssue = [
	issue?.volume != null && `Volume ${issue.volume}`,
	issue?.issueNumber != null && `Number ${issue.issueNumber}`,
]
	.filter(Boolean)
	.join(', ')
const pages =
	article.startPage != null
		? article.endPage != null && article.endPage !== article.startPage
			? `pp. ${article.startPage}–${article.endPage}`
			: `p. ${article.startPage}`
		: null
const meta = [volIssue, article.authorText, pages].filter(Boolean).join(' · ')
---

<Layout title={article.title ?? slug} ogType="article">
	<p class="font-sans text-sm tracking-[0.08em] uppercase text-on-surface-variant">
		<a href="/quarterly" class="text-on-surface-variant no-underline hover:text-primary">
			Quarterly
		</a>
	</p>
	<h1 class="mt-3 text-display-sm">{article.title}</h1>
	{
		meta ? (
			<p class="mt-3 font-sans text-on-surface-variant">{meta}</p>
		) : null
	}
	{
		article.summary ? (
			<p class="mt-6 max-w-3xl font-sans text-on-surface-variant">{article.summary}</p>
		) : null
	}
	{
		article.body?.length ? (
			<div class="prose prose-lg mt-8 font-sans">
				<PortableTextBody value={article.body} />
			</div>
		) : null
	}
	{
		article.notesAndReferences?.length ? (
			<section class="mt-16 bg-surface-dim p-8">
				<h2 class="text-2xl">Notes and references</h2>
				<div class="prose prose-lg mt-4 font-sans">
					<PortableTextBody value={article.notesAndReferences} />
				</div>
			</section>
		) : null
	}
</Layout>
